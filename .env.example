BOT_TOKEN=123456789:replace_with_botfather_token
DATABASE_URL=sqlite:///data/bot.db
STORAGE_DIR=data/storage
MAX_UPLOAD_MB=20
RETENTION_MINUTES=60
# Comma-separated public usernames or numeric chat IDs. Example: @mychannel
REQUIRED_CHANNELS=@FastTGConvert
# Support username/ID shown in Help & Support (examples: @admin or 123456789)
SUPPORT_ID=@your_support_username
# Telegram API credentials from https://my.telegram.org (required for spam check)
# API_ID=
# API_HASH=
# Timeout in seconds waiting for @SpamBot reply (default: 15)
# SPAMBOT_TIMEOUT=15

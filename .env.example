# ==============================================================================
# 🤖 BOT & ADMIN CREDENTIALS
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (REQUIRED)
BOT_TOKEN=123456789:replace_with_botfather_token

# Telegram System Owner / Primary Admin User ID (Numeric Telegram ID)
ADMIN_ID=123456789

# Telegram API credentials from https://my.telegram.org (Required for Telethon & SpamCheck)
# Format: api_id:api_hash (Supports multiple comma-separated pairs)
# Example: API_CREDENTIALS=123456:abcdef0123456789abcdef0123456789
API_CREDENTIALS=123456:abcdef0123456789abcdef0123456789


# ==============================================================================
# 🗄️ DATABASE & FILE STORAGE
# ==============================================================================

# Database Connection URL (SQLite)
DATABASE_URL=sqlite:///data/bot.db

# Storage Directory for temporary upload processing
STORAGE_DIR=data/storage

# Maximum allowed file upload size per user in MB (Default: 20)
MAX_UPLOAD_MB=20

# Cleanup retention period in minutes for temporary files (Default: 60)
RETENTION_MINUTES=60


# ==============================================================================
# 🔒 PROXY & SECURITY
# ==============================================================================

# Optional 32-byte URL-safe Base64 key for encrypting user proxy credentials
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PROXY_ENCRYPTION_KEY=g4T7-k9X_zA1bC2dE3fG4hI5jK6lM7nO8pQ9rS0tU1V=


# ==============================================================================
# 📊 METRICS & OBSERVABILITY (Prometheus)
# ==============================================================================

# Enable or disable Prometheus HTTP metrics endpoint (Default: true)
METRICS_ENABLED=true

# Host address to bind the metrics server (Default: 127.0.0.1 for local security)
METRICS_HOST=127.0.0.1

# HTTP Port for Prometheus scraping & health endpoints (Default: 8080)
METRICS_PORT=8080

# Bearer Token for securing HTTP /metrics endpoint (Leave empty to disable auth)
METRICS_AUTH_TOKEN=your_secure_bearer_token_here


# ==============================================================================
# ⚙️ ADVANCED & TIMEOUTS
# ==============================================================================

# Timeout in seconds waiting for @SpamBot reply (Default: 15)
SPAMBOT_TIMEOUT=15

# Initial fallback Support Contact (Note: Managed dynamically in DB via Admin Panel)
SUPPORT_ID=@admin_support

# Initial fallback Force Join channels (Note: Managed dynamically in DB via Admin Panel)
# Comma-separated usernames or channel IDs (e.g., @mychannel)
REQUIRED_CHANNELS=@FastTGConvert


# ==============================================================================
# ℹ️ DYNAMIC DATABASE SETTINGS (No ENV Required)
# ==============================================================================
# The following systems are now 100% managed dynamically via DB & Admin Panel:
#  - Payment Gateways (TRC20, BEP20, Binance Pay ID, Manual/Auto switches -> `payment_settings` table)
#  - VIP Plans (Pricing, Duration, Currency -> `vip_plans` table)
#  - Force Join Channels (Dynamic add/remove/toggle -> `force_join_channels` table)
#  - Support Username (Dynamic change -> `system_settings` table)

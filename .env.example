# ==============================================================================
# 📊 METRICS & OBSERVABILITY (Prometheus)
# ==============================================================================

# Enable or disable Prometheus HTTP metrics endpoint (Default: true)
METRICS_ENABLED=true

# Host address to bind the metrics server (Default: 127.0.0.1 for local security)
METRICS_HOST=127.0.0.1

# HTTP Port for Prometheus scraping & health endpoints (Default: 8080)
METRICS_PORT=8080

# Bearer Token for securing HTTP /metrics endpoint (Leave empty to disable auth)
METRICS_AUTH_TOKEN=your_secure_bearer_token_here


# ==============================================================================
# ⚙️ ADVANCED & TIMEOUTS
# ==============================================================================

# Timeout in seconds waiting for @SpamBot reply (Default: 15)
SPAMBOT_TIMEOUT=15

# Initial fallback Support Contact (Note: Managed dynamically in DB via Admin Panel)
SUPPORT_ID=@admin_support

# Initial fallback Force Join channels (Note: Managed dynamically in DB via Admin Panel)
# Comma-separated usernames or channel IDs (e.g., @mychannel)
REQUIRED_CHANNELS=@FastTGConvert


# ==============================================================================
# ℹ️ DYNAMIC DATABASE SETTINGS (No ENV Required)
# ==============================================================================
# The following systems are now 100% managed dynamically via DB & Admin Panel:
#  - Payment Gateways (TRC20, BEP20, Binance Pay ID, Manual/Auto switches -> `payment_settings` table)
#  - VIP Plans (Pricing, Duration, Currency -> `vip_plans` table)
#  - Force Join Channels (Dynamic add/remove/toggle -> `force_join_channels` table)
#  - Support Username (Dynamic change -> `system_settings` table)


# ==============================================================================
# 💳 PAYMENT GATEWAYS — AUTO CRYPTO DETECTION (TRC20 / BEP20 USDT)
# ==============================================================================

# Optional API keys for on-chain payment verification (higher rate limits).
# Leave empty to use the unauthenticated public endpoints.
TRON_API_KEY=
# Etherscan V2 API key (https://etherscan.io) for BSC (BEP20) detection. The legacy
# api.bscscan.com V1 endpoint is decommissioned, and V2 requires a PAID plan for the
# BNB chain — without it BEP20 auto-detection stays unavailable.
BSC_API_KEY=

# FREE alternative to BSC_API_KEY: comma-separated BSC RPC node URLs. When set,
# BEP20 auto-detection switches to keyless eth_getLogs scanning on these nodes
# (no paid plan needed). Leave empty to keep the Etherscan V2 path.
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.ninicoin.io,https://bsc-dataseed3.ninicoin.io,https://bsc-rpc.publicnode.com

# How often the bot scans for confirmed on-chain payments, in seconds (Default: 15)
PAYMENT_CHECK_INTERVAL_SECONDS=15

# Validity window for auto payment orders, in hours (Default: 2)
PAYMENT_ORDER_HOURS=2

# Extra seconds AFTER expiry that a confirmed payment still activates VIP
# (protects customers paying at the very edge of the window; Default: 1200)
PAYMENT_EXPIRY_GRACE_SECONDS=1200
